

# Application Environment
ENVIRONMENT="development"
PROJECT_NAME="Smart Tablekeeper"
PORT=3000

# Backend Configuration (FastAPI)
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="tablekeeper"
POSTGRES_PASSWORD="tablekeeper_secure_password"
POSTGRES_DB="smart_tablekeeper"
DATABASE_URL="postgresql+asyncpg://tablekeeper:tablekeeper_secure_password@localhost:5432/smart_tablekeeper"

# Redis Configuration (Caching, Distributed Locking, Queues)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Frontend Configuration
VITE_API_BASE_URL="/api/v1"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
VITE_SITE_URL="https://your-domain.example"
